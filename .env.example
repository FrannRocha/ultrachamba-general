# Configuración de Ultrachamba. Copia este archivo como `.env` en la raíz del
# proyecto (junto a este) y cambia lo que necesites.
#
# `app/config.py` SÍ lee `.env` al arrancar, sin librerías externas: formato
# CLAVE=valor, una por línea, `#` para comentarios. Si una variable ya está
# definida en el entorno del sistema, esa manda sobre `.env`.
#
# `.env` está en .gitignore: no lo subas nunca al repositorio.

# Áreas profesionales activas: claves separadas por comas, o `todas`.
#   tecnologia, contabilidad-finanzas, administracion, mercadotecnia-ventas,
#   recursos-humanos, derecho, ingenieria-industrial, salud
# En tecnología también valen sus categorías sueltas:
#   ciber-ia, ciberseguridad, ia, ti-general
# Un nombre desconocido detiene el programa con un mensaje claro.
ULTRACHAMBA_AREAS=todas

# Zona base:
#   monterrey  área metropolitana de Monterrey. Busca ahí y calcula si una
#              vacante presencial exige mudarse.
#   nacional   todo México, sin zona base: no marca "en tu zona" ni calcula
#              mudanza.
ULTRACHAMBA_ZONA=monterrey

# Clave de la API de Indeed que usa su aplicación móvil. No hay una clave
# pública ni se incluye ninguna: vacía, la fuente Indeed queda desactivada y lo
# dice en el registro. Es un secreto: solo en `.env`, nunca en el código.
INDEED_API_KEY=
